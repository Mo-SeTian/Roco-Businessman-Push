# ===== 复制为 .env 后按需填写 =====
# 大部分配置现在可以直接在 Web 控制台（http://localhost:19892）里完成，
# 环境变量的作用是"首次启动的兜底/种子值"，WebUI 里保存的配置（/data/config.json）优先。

# ---- RoCom API（也可在 WebUI「全局设置」里填）----
# 官网开发者控制台申请：https://rocom.shallow.ink/developer/api-keys
# 需订阅/开通 RoCom Ingame 商店信息权限
ROCOM_API_KEY=
# 要轮询的商店 ID，逗号分隔；留空 = 服务端默认远行商店(3009)
#ROCOM_SHOP_ID=3009

# ---- 控制台登录（默认账号密码均为 admin/admin，登录后可在 WebUI 里修改）----
# 以下两个变量仅用于首次初始化时覆盖默认值
#CONSOLE_USERNAME=admin
#CONSOLE_PASSWORD=admin
#WEB_PORT=19892

# ---- 渠道种子（WebUI「推送渠道」里可视化增删，多个渠道/同渠道多实例直接在页面建）----
# 首次启动时，下面配了凭据的渠道会自动生成对应的渠道实例和默认任务
#SERVERCHAN_SENDKEY=
#BARK_SERVER=https://api.day.app
#BARK_DEVICE_KEY=
#BARK_SOUND=
#BARK_GROUP=
#PUSHPLUS_TOKEN=
#PUSHPLUS_TOPIC=
#WECOM_CORP_ID=
#WECOM_CORP_SECRET=
#WECOM_AGENT_ID=
#WECOM_TOUSER=@all
#WXPUSHER_APP_TOKEN=
#WXPUSHER_UIDS=
#WXPUSHER_TOPIC_IDS=

# ---- 接口细节（一般不用动）----
#ROCOM_API_BASE=https://wegame.shallow.ink
#ROCOM_WAIT_MS=8000
#ROCOM_HTTP_TIMEOUT=30
#ROCOM_MAX_RETRIES=3
#ROCOM_RETRY_DELAY=20

# ---- 调度 ----
# 启动时立即执行一次（默认 1）
#RUN_ON_START=1
# 设为 1 时执行一轮所有启用任务就退出（配合外部 cron）
#RUN_ONCE=0

# ---- 日志 ----
# 文件日志目录（与 /data 同级），按天滚动，保留 LOG_RETENTION_DAYS 天后自动清理
#LOG_DIR=/logs
#LOG_RETENTION_DAYS=7
# 采集级别（同时作用于控制台/文件/WebUI 日志页），需要看 DEBUG 时设为 DEBUG
#LOG_LEVEL=INFO
